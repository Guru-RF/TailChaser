"""tailchaser-announce — make the spoken announcements a TailChaser node plays.

    tailchaser-announce -c /etc/tailchaser/duplex.conf [--all-day] [--say HH:MM]

Reads [announce] from the node's configuration, turns the text into speech
with an online voice service and writes one 16 kHz WAV per announcement time
into [announce] dir: 0015.wav, 0030.wav, ... — the daemon plays the one whose
time has come. Meant to run once a day, shortly after midnight (and after a
boot): `systemctl enable --now tailchaser-announce@<role>.timer`.

In the text:   %CALL  the callsign, spelled out — letter by letter, or with
                      call_spelling = phonetic as "Oscar November Zero ..."
               %TIME  the time of the announcement — 14:15, or with
                      time_style = spoken as "quarter past two" (English)
               %DATE  the date
               %PAUSE a pause (pause_ms, 1000): "This is %CALL %PAUSE it's %TIME"
Every different text is sent to the service once and kept; a text without
%TIME is one request for the whole day.

Only the Python standard library is used.
"""
import argparse
import datetime
import hashlib
import json
import locale
import math
import os
import re
import struct
import sys
import tempfile
import time
import urllib.error
import urllib.request
import wave

RATE = 16000


# --------------------------------------------------------------------------
# the configuration: the same file the daemon reads

def read_conf(path):
    conf, sec = {}, None
    with open(path, encoding="utf-8") as f:
        for raw in f:
            line = raw.strip()
            if not line or line[0] in "#;":
                continue
            m = re.match(r"^\[(\w+)\]", line)
            if m:
                sec = m.group(1)
                conf.setdefault(sec, {})
                continue
            if sec is None or "=" not in line:
                continue
            key, val = line.split("=", 1)
            val = val.strip()
            if val[:1] == '"':                              # "quoted": to the closing quote
                end = val.find('"', 1)
                val = val[1:end] if end > 0 else val[1:]
            else:
                val = re.split(r"\s+[#;]", val, maxsplit=1)[0].strip()
            conf[sec].setdefault(key.strip(), []).append(val)
    return conf


def one(conf, sec, key, default=""):
    v = conf.get(sec, {}).get(key)
    return v[-1] if v else default


# --------------------------------------------------------------------------
# audio

def parse_wav(data):
    """(samples, rate) of a 16-bit WAV — also one that was streamed and does
    not know its own length."""
    if data[:4] != b"RIFF" or data[8:12] != b"WAVE":
        raise ValueError("the service did not answer with a WAV file")
    pos, rate, channels, bits = 12, 0, 1, 16
    while pos + 8 <= len(data):
        tag, size = data[pos:pos + 4], struct.unpack("<I", data[pos + 4:pos + 8])[0]
        body = pos + 8
        if tag == b"fmt ":
            _, channels, rate, _, _, bits = struct.unpack("<HHIIHH", data[body:body + 16])
        elif tag == b"data":
            raw = data[body:body + size] if body + size <= len(data) else data[body:]
            if bits != 16:
                raise ValueError(f"{bits}-bit audio: 16-bit is needed")
            n = len(raw) // 2
            s = struct.unpack(f"<{n}h", raw[:n * 2])
            return list(s[::channels]), rate
        pos = body + size + (size & 1)
    raise ValueError("no audio in the answer")


def resample(x, src, dst=RATE):
    if src == dst or not x:
        return list(x)
    try:                                    # fast, where Python still has it
        import audioop
        raw = struct.pack(f"<{len(x)}h", *x)
        out, _ = audioop.ratecv(raw, 2, 1, src, dst, None)
        return list(struct.unpack(f"<{len(out) // 2}h", out))
    except ImportError:
        pass
    # windowed sinc, 8 zero crossings each side, cut off below the lower rate
    fc = 0.45 * min(src, dst) / src
    half = int(8 / (2 * fc)) + 1
    step = src / dst
    n_out = int(len(x) / step)
    out = []
    for i in range(n_out):
        t = i * step
        k0 = int(t)
        acc = 0.0
        for k in range(max(0, k0 - half + 1), min(len(x), k0 + half + 1)):
            d = t - k
            w = 0.5 + 0.5 * math.cos(math.pi * d / (half + 1))
            acc += x[k] * (2 * fc if d == 0 else math.sin(2 * math.pi * fc * d) / (math.pi * d)) * w
        out.append(max(-32768, min(32767, int(round(acc)))))
    return out


def write_wav(path, samples):
    """Atomically: the daemon must never read half a file."""
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), suffix=".tmp")
    os.close(fd)
    with wave.open(tmp, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(RATE)
        w.writeframes(struct.pack(f"<{len(samples)}h", *samples))
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


# --------------------------------------------------------------------------
# the voice services

def http_post(url, headers, body, timeout=60):
    req = urllib.request.Request(url, data=json.dumps(body).encode(), headers=headers, method="POST")
    req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            data = r.read(32 * 1024 * 1024 + 1)
            if len(data) > 32 * 1024 * 1024:
                raise RuntimeError("the voice service sent more than 32 MB — not an announcement")
            return data
    except urllib.error.HTTPError as e:
        detail = e.read(300).decode("utf-8", "replace").strip()
        raise RuntimeError(f"HTTP {e.code} from the voice service: {detail}") from None
    except urllib.error.URLError as e:
        raise RuntimeError(f"cannot reach the voice service: {e.reason}") from None


def speak(conf, text):
    """The text as 16 kHz samples."""
    an = conf.get("announce", {})
    get = lambda k, d="": an[k][-1] if an.get(k) else d      # noqa: E731
    provider = get("provider", "openai").lower()
    token = get("token") or os.environ.get("TAILCHASER_TTS_TOKEN", "")
    target = get("url")
    if target and not target.startswith("https://") and not re.match(r"http://(127\.0\.0\.1|localhost)[:/]", target):
        raise RuntimeError("[announce] url must be https:// — the token is sent to it")
    if not token:
        raise RuntimeError("[announce] token is empty (or TAILCHASER_TTS_TOKEN)")
    if provider == "openai":                # and everything that speaks its API
        url = get("url", "https://api.openai.com/v1/audio/speech")
        body = {"model": get("model", "gpt-4o-mini-tts"), "voice": get("voice", "alloy"),
                "input": text, "response_format": "wav"}
        if get("style"):
            body["instructions"] = get("style")
        if get("speed"):
            body["speed"] = float(get("speed"))
        pcm, rate = parse_wav(http_post(url, {"Authorization": f"Bearer {token}"}, body))
        return resample(pcm, rate)
    if provider == "elevenlabs":
        voice = get("voice")
        if not voice:
            raise RuntimeError("[announce] voice is required for elevenlabs: a voice id")
        url = get("url", "https://api.elevenlabs.io/v1/text-to-speech") + f"/{voice}?output_format=pcm_16000"
        body = {"text": text, "model_id": get("model", "eleven_multilingual_v2")}
        if get("speed"):                                    # 0.7 (slow) .. 1.2 (fast)
            body["voice_settings"] = {"speed": float(get("speed"))}
        raw = http_post(url, {"xi-api-key": token}, body)
        n = len(raw) // 2
        return list(struct.unpack(f"<{n}h", raw[:n * 2]))
    raise RuntimeError(f"[announce] provider '{provider}' is not known: openai | elevenlabs")


# --------------------------------------------------------------------------

def texts_of(conf):
    an = conf.get("announce", {})
    out = [t for t in an.get("text", []) if t]
    path = one(conf, "announce", "text_file")
    if path:
        with open(path, encoding="utf-8") as f:
            out += [l.strip() for l in f if l.strip() and not l.lstrip().startswith("#")]
    return out


def spoken_call(conf):
    said = one(conf, "announce", "call_spoken")
    if said:
        return said
    call = one(conf, "ident", "callsign") or one(conf, "reflector", "callsign")
    call = call.split("-")[0].upper()
    if one(conf, "announce", "call_spelling", "letters").lower() == "phonetic":
        return ", ".join(PHONETIC.get(c, c) for c in call)  # Oscar, November, Zero, ... — said one by one
    return " ".join(call)                                   # O N 0 X X X


PHONETIC = dict(zip("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789",
                    "Alfa Bravo Charlie Delta Echo Foxtrot Golf Hotel India Juliett Kilo Lima Mike "
                    "November Oscar Papa Quebec Romeo Sierra Tango Uniform Victor Whiskey X-ray Yankee "
                    "Zulu Zero One Two Three Four Five Six Seven Eight Nine".split()))
NUMBER = ("twelve one two three four five six seven eight nine ten eleven twelve thirteen fourteen "
          "fifteen sixteen seventeen eighteen nineteen twenty twenty-one twenty-two twenty-three "
          "twenty-four twenty-five twenty-six twenty-seven twenty-eight twenty-nine").split()


def spoken_time(when):
    """The time the way it is said: "quarter past three", "ten to midnight"."""
    def hour(h):
        h %= 24
        return "midnight" if h == 0 else NUMBER[h % 12]
    h, m = when.hour, when.minute
    if m == 0:
        return "midnight" if h == 0 else "twelve noon" if h == 12 else f"{hour(h)} o'clock"
    if m == 15:
        return f"quarter past {hour(h)}"
    if m == 30:
        return f"half past {hour(h)}"
    if m == 45:
        return f"quarter to {hour(h + 1)}"
    n, word, of = (m, "past", h) if m < 30 else (60 - m, "to", h + 1)
    unit = "" if n % 5 == 0 else " minute" if n == 1 else " minutes"
    return f"{NUMBER[n]}{unit} {word} {hour(of)}"


def render(template, conf, when):
    tf = one(conf, "announce", "time_format", "%H:%M")
    df = one(conf, "announce", "date_format", "%A %-d %B %Y")
    spoken = one(conf, "announce", "time_style", "clock").lower() == "spoken"
    return (template.replace("%CALL", spoken_call(conf))
                    .replace("%TIME", spoken_time(when) if spoken else when.strftime(tf))
                    .replace("%DATE", when.strftime(df)))


def slots(conf, start, all_day):
    """The announcement times from `start` to midnight: every interval, but
    not when the Morse identification is sent — unless with_ident is set:
    then those too, and the one of the coming midnight."""
    step = int(one(conf, "announce", "interval_min", "15"))
    ident = int(one(conf, "ident", "interval_min", "60"))
    day = start.replace(hour=0, minute=0, second=0, microsecond=0)
    both = one(conf, "announce", "with_ident", "false").lower() in ("1", "true", "yes", "on")
    out = []
    for m in range(step, 1440 + (1 if both else 0), step):
        if ident > 0 and m % ident == 0 and not both:
            continue
        t = day + datetime.timedelta(minutes=m)
        if all_day or t > start:
            out.append(t)
    return out


def main():
    ap = argparse.ArgumentParser(description="Make the spoken announcements of a TailChaser node.")
    ap.add_argument("-c", "--config", required=True)
    ap.add_argument("--all-day", action="store_true", help="also the times of today that have passed")
    ap.add_argument("--say", metavar="HH:MM", help="only this one, and print where it is")
    ap.add_argument("--dry-run", action="store_true", help="print the texts, ask the service nothing")
    args = ap.parse_args()

    conf = read_conf(args.config)
    if one(conf, "announce", "enabled", "false").lower() not in ("1", "true", "yes", "on") and not args.say:
        print("[announce] enabled is not true — nothing to do")
        return 0
    loc = one(conf, "announce", "locale")
    if loc:
        try:
            locale.setlocale(locale.LC_TIME, loc)
        except locale.Error:
            print(f"warning: locale {loc} is not installed — dates in the system's language", file=sys.stderr)
    templates = texts_of(conf)
    if not templates:
        print("error: [announce] has no text (text = ... or text_file = ...)", file=sys.stderr)
        return 1
    out_dir = one(conf, "announce", "dir", "/var/lib/tailchaser/announce")
    cache = os.path.join(out_dir, "cache")
    os.makedirs(cache, exist_ok=True)

    now = datetime.datetime.now()
    if args.say:
        h, m = (int(x) for x in args.say.split(":"))
        todo = [now.replace(hour=h, minute=m, second=0, microsecond=0)]
    else:
        todo = slots(conf, now, args.all_day)

    asked = failed = 0
    voice_id = "|".join(one(conf, "announce", k) for k in ("provider", "url", "model", "voice", "style", "speed"))
    for i, when in enumerate(todo):
        # which text: they take turns through the day
        idx = (when.hour * 60 + when.minute) // max(1, int(one(conf, "announce", "interval_min", "15")))
        text = render(templates[idx % len(templates)], conf, when)
        name = when.strftime("%H%M") + ".wav"
        if args.dry_run:
            print(f"{when:%H:%M}  {text}")
            continue
        # %PAUSE: each part is spoken on its own and they are joined with
        # silence — the same with every voice service, and a part that comes
        # back every time ("This is ...") is asked for once.
        # What is written at the end of a part stays: "This is %CALL, %PAUSE"
        # is said as a sentence that goes on, not as one that is cut off.
        parts = [p.lstrip(" ,;").rstrip() for p in text.split("%PAUSE")]
        gap = [0] * int(RATE * float(one(conf, "announce", "pause_ms", "1000")) / 1000)
        kept = ""
        try:
            pcm = []
            for part in (p for p in parts if p):
                key = hashlib.sha1((voice_id + "\n" + part).encode()).hexdigest()
                kept = os.path.join(cache, key + ".wav")
                if os.path.exists(kept):
                    with wave.open(kept, "rb") as w:
                        n = w.getnframes()
                        one_part = list(struct.unpack(f"<{n}h", w.readframes(n)))
                    os.utime(kept)                              # still in use
                else:
                    one_part = speak(conf, part)
                    if len(one_part) < RATE // 4:
                        raise RuntimeError("the service answered with next to no audio")
                    write_wav(kept, one_part)
                    asked += 1
                pcm += (gap if pcm else []) + one_part
            write_wav(os.path.join(out_dir, name), pcm)         # new every day: the daemon checks
        except (RuntimeError, ValueError, OSError, struct.error, wave.Error, EOFError) as e:
            if kept and os.path.exists(kept) and not isinstance(e, RuntimeError):
                try:
                    os.remove(kept)                             # a kept file that cannot be read: ask again next time
                except OSError:
                    pass
            failed += 1
            print(f"error: {when:%H:%M}: {e}", file=sys.stderr)
            if failed >= 3 and asked == 0:
                print("error: giving up — nothing works", file=sys.stderr)
                break
        if args.say:
            print(os.path.join(out_dir, name))

    if not args.dry_run:
        # what is kept but was not used for two days goes
        for f in os.listdir(cache):
            p = os.path.join(cache, f)
            if time.time() - os.path.getmtime(p) > 2 * 86400:
                try:
                    os.remove(p)
                except OSError:
                    pass
        print(f"{len(todo)} announcement(s) for {now:%Y-%m-%d}, {asked} request(s) to the voice service, "
              f"{failed} failed — in {out_dir}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
