# TailChaser — tailchaser-transmitter: the transmit site of a split repeater
#
# Copy to /etc/tailchaser/transmitter.conf and edit. Lines starting with '#' or ';'
# are comments; a value may be put in "quotes". The four programs
# (tailchaser-simplex, -duplex, -receiver, -transmitter) read the same kind of
# file: a section means the same thing in each of them, and a program only has
# the sections for the parts it has.
#
# For a new node you set the lines marked REQUIRED — they are commented out
# here, and until they are filled in tailchaser-transmitter refuses to start: a box
# that was not set up does not transmit.
#
#   [reflector] domain / host   the SvxReflector / TailchaserReflector to connect to
#   [reflector] callsign        the node's login there (e.g. ON0XXX)
#   [reflector] default_tg      its talkgroup
#   [receiver]  host            where its tailchaser-receiver is
#   [radio]     freq_tx         the output frequency, in MHz
#   [ident]     callsign        what is sent in Morse on the hour
#
# Check the file with:  tailchaser-transmitter -t -c /etc/tailchaser/transmitter.conf

[reflector]
# Where the reflector is — an SvxReflector or a TailchaserReflector, they speak
# the same protocol. Either a DNS domain that publishes it
# (_svxreflector._tcp.<domain>, SvxLink's DNS_DOMAIN) ...
#domain       = be.svx.link                # REQUIRED: this, or host
# ... or its address: host[:port], or several, tried in order (SvxLink's HOSTS).
#host         = reflector.example.org:5300
port          = 5300                       # for a host given without a port
#callsign     = ON0XXX                     # REQUIRED. The login on the reflector.

# How the node proves who it is:
#   certificate (the default)  On its first connection the node makes a key and
#                              sends a signing request; the reflector's sysop
#                              signs it, and from then on the node logs in with
#                              the certificate. Renewals are automatic.
#   password                   For reflectors that still use one: set auth_key.
#auth_key     =                            # Keep it out of git.
email         =                            # contact address, goes into the certificate request
verify_host   = true                       # the reflector's certificate must name it. The CA
                                           # is kept from the first connection (pki_dir) and
                                           # checked from then on.
pki_dir       = /var/lib/tailchaser/pki    # key + certificate. Back this directory up.

#default_tg   = 1745                       # REQUIRED in practice: the node's home talkgroup
monitor_tgs   =                            # others to listen on, SvxLink notation: 1745++, 8+, 9
                                           #   (the + are the priority). When somebody
                                           #   talks on one and the node is idle, it
                                           #   switches there and transmits them.
tg_select_timeout_s = 30                   # back to the home talkgroup after this much silence
udp_heartbeat_s = 10                       # keeps the NAT/firewall hole for the audio open

# Shown on the reflector's dashboards. All optional.
location      =                            # "Brussels"
sysop         =                            # defaults to the callsign
qth_name      =
latitude      =                            # 50.8467
longitude     =                            # 4.3525
locator       =                            # JO20eu

# More of the station for those dashboards and maps. The frequencies and the
# tones are taken from [radio] and [ctcss]; say them here when the program
# does not know them (type = none, or the receiver is at another site).
[location]
#freq_rx      = 431.2000                   # MHz
#freq_tx      = 438.8000
#ctcss_rx     = 88.5                       # Hz | none
#ctcss_tx     = 88.5
#power_w      = 10                         # transmitter output
#antenna      = X300 7 dBi
#antenna_height_m = 25                     # above ground
#antenna_dir  = omni                       # or degrees
hidden        = false                      # true = ask the dashboards not to list the node
tone_to_talkgroup = true                   # tell which CTCSS tone opens the home talkgroup

[receiver]
# The receive site: a tailchaser-receiver. This program connects to it and is
# told when a station is on the input, how strong it is, which DTMF digits were
# pressed — and is sent the audio.
#host         = on0xxx-rx.example.org      # REQUIRED. host or host:port
port          = 5210
auth_key      =                            # the receiver's [uplink] auth_key
status_port   = 8080                       # the receiver's status page: what it shows is passed
                                           # on in this node's status and API as "remote_receiver",
                                           # so one address answers for the whole repeater (0 = not)
codec         = S16                        # S16 (uncompressed, for a LAN) | OPUS (a slow link)

# More receivers, and voting. Besides the receive site above, up to three
# others can be listened to: a tailchaser-receiver on another site, or a
# tailchaser-sdrreceiver — a web SDR (OpenWebRX, KiwiSDR, Web-888, UberSDR)
# tuned to the repeater's input. The receiver that hears a
# station first has the over; a better one takes it over; what a late one
# (a web SDR is a second or two behind) still brings of an over that has ended
# is not listened to.
#[receiver2]
#host         = 127.0.0.1:5211             # a tailchaser-sdrreceiver on this box
#auth_key     =                            # its [uplink] auth_key
#name         = web SDR                    # in the log and on the status page
#siglev_offset = 0                         # added to the signal it reports, before the vote
#lag_ms       = 0                          # how far behind it always is, in ms (a web SDR):
                                           #   measure it with tools/sdrlag.py. 0 = learned
                                           #   from the overs it shares with another receiver.
#codec        = S16
#[receiver3] ...

#[voter]
#switch       = true                       # another receiver takes an over when it hears it better...
#margin       = 25                         # ...by this much (signal, 0..100)
#hold_ms      = 500                        # ...for this long
#switch_lag_ms = 300                       # ...but not a receiver this much behind or ahead (a web SDR):
                                           # the last words would be heard twice, or missed
#late_ms      = 700                        # a receiver still open after the one that had the over
                                           # closed: its late copy for its delay plus this long;
                                           # after that it is a station of its own

[radio]
type          = sa818                      # sa818 = an SA818 module, programmed by this
                                           #   program over its serial port.
                                           # none  = a radio that needs no programming:
                                           #   only its audio and its GPIO lines are used.
serial_port   = /dev/serial0               # SA818 UART
#freq_tx      = 438.8000                   # MHz. REQUIRED — the output of the repeater.
bandwidth     = narrow                     # narrow (12.5 kHz) | wide (25 kHz)
ctcss_tx      = none                       # none = nothing is added to the transmission.
                                           #   A tone in Hz (e.g. 88.5): sent along, for
                                           #   listeners who run tone squelch.
volume        = 1                          # 1..8 chip audio level
filter_emphasis = 0                        # SA818 audio filters: 0 = enabled, 1 = bypassed.
filter_highpass = 0                        #   With an RX tone, leave the high-pass ON — it
filter_lowpass  = 0                        #   strips the tone from the audio.
ptt_line      = 16                         # GPIO16 = SA818 PTT
ptt_active_low= true
pa_line       = none                       # A GPIO that switches a power amplifier: taken
pa_active_low = true                       #   just before PTT, released just after it.
pa_delay_ms   = 0                          #   0 = as above. More = the amplifier this long
                                           #   AFTER the PTT (and off before it): a sequencer.
                                           #   Keep [tx] delay_ms at least as long.
refresh_after_tx = false                   # true = give the SA818 its filter settings again
                                           #   after every transmission (a module next to a
                                           #   PA can lose them).

[tx]
delay_ms      = 300        # Carrier first, audio this much later: time for the listeners'
                           # squelch (and tone decoder) to open. Nothing is lost to it —
                           # the audio waits.
hang_ms       = 3000       # The carrier stays up this long after the last audio, so the
                           # next station does not have to open the repeater again.
timeout_s     = 360        # Longest the transmitter stays busy without a pause. After it
                           # the carrier drops and stays down until whoever was talking
                           # has stopped. 0 = no limit.
normalize     = true       # talkgroup audio is brought to [audio] normalize_target_db,
                           # like a station on the input: everything that is
normalize_max_gain_db = 15 # transmitted has one level, whoever sent it
gain_db       = 0          # software gain on talkgroup audio before it is transmitted
level_db      = 0          # software gain on everything that is transmitted — speech,
                           # beeps, Morse, test tones (SvxLink: MASTER_GAIN)
duck_db       = 6          # Morse and announcements are this much quieter while
                           # somebody is talking, and come back up when they stop
preemphasis   = false      # true = 6 dB/octave pre-emphasis in software, for a radio whose
                           # own pre-emphasis is bypassed (filter_emphasis = 1)
limit_db      = 0          # Ceiling on what goes to the modulator, in dBFS (e.g. -3).
                           # 0 = no limiter.
test_s        = 10         # A test transmission, for setting the deviation:
test_level_db = -20        #   sudo systemctl kill -s USR1 tailchaser-<role>
                           # sends 1000 Hz, then 700 + 1900 Hz, half of test_s each,
                           # at this peak level — as soon as the transmitter is free.

[repeater]
# After an over the repeater answers. A station on its own input: the roger
# beep. An over from the talkgroup: which repeater it came through, in fast
# Morse — or the callsign of a station that is not on a repeater.
roger_beep    = true       # "blop" after every over that was repeated: the repeater
                           # heard you, the next one can go
roger_tones   = 800        # its pitch in Hz — or several, one after the other
roger_net_beep = true      # "bleep blop" after an over from the talkgroup that gets
roger_net_tones = 1200, 800  # no Morse after it (below): that one came in over the network
roger_delay_ms = 200       # this long after the over
net_call      = false      # true = which repeater an over from the talkgroup came
                           # through, in fast Morse: ON0OST by the letters after
net_call_prefix = ON0      # this prefix — "OST".
net_call_full = true       # A station that is not on a repeater: its callsign,
                           # whole (ON4ABC-P as ON4ABC). false = no Morse for it,
                           # and the bleep blop after its over.
net_call_when = after      # after = when the over has ended, in place of the bleep
                           # blop; the speech starts at once, and the Morse is
                           # dropped when somebody talks again first.
                           # before = ahead of the over: the speech waits for it,
                           # and the bleep blop follows the over as well.
net_call_once = false      # true = only when it is another repeater than the one
                           # sent last (a conversation through one repeater is
                           # announced once)
net_call_wpm  = 34
net_call_pitch_hz = 800
net_call_level_db = -20
net_call_lead_ms = 600     # (before) silence first when the transmitter was off:
                           # the listeners' squelch has to open
roger_ms      = 70         # each tone
roger_gap_ms  = 20         # silence between them
roger_level_db = -18       # dBFS

[ident]
#callsign     = ON0XXX     # REQUIRED (unless interval_min = 0)
interval_min  = 60         # On the clock: 60 = every hour on the hour, 30 = also at half
                           # past, 10 = every ten minutes. 0 = never.
wpm           = 24         # Morse speed
pitch_hz      = 600        # tone
level_db      = -12        # dBFS

# A spoken announcement on the clock: every interval_min, except when the Morse
# identification is due (with both at their defaults: at :15, :30 and :45).
# The daemon plays <dir>/HHMM.wav; `tailchaser-announce` makes those files once
# a day, from the text below, with an online voice service:
#   sudo systemctl enable --now tailchaser-announce@transmitter.timer
#   sudo -u tailchaser tailchaser-announce -c /etc/tailchaser/transmitter.conf --dry-run
[announce]
enabled       = false
interval_min  = 15
with_ident    = false      # true = also when the Morse is due: the Morse first, then
                           #   the announcement, in one transmission
busy          = wait       # wait = only in a quiet moment; when there is none within
                           #   wait_s, the announcement is left out.
                           # duck = start anyway, [tx] duck_db quieter, under whoever
                           #   is talking. Either way: when somebody starts talking
                           #   while it plays, it goes under them.
wait_s        = 120
level_db      = -16        # the speech is brought to this level (dBFS RMS)
max_s         = 30         # never longer than this
dir           = /var/lib/tailchaser/announce

# For tailchaser-announce. %CALL = the callsign, spelled; %TIME; %DATE;
# %PAUSE = a pause of pause_ms: "This is %CALL %PAUSE it's %TIME".
# Several text lines take turns through the day.
#text         = "This is %CALL. It is %TIME."
#text_file    = /etc/tailchaser/announce.txt     # one text per line
#call_spoken  = Oscar November zero X-ray X-ray X-ray    # instead of the letters
call_spelling = letters    # letters = O N 0 X X X | phonetic = Oscar, November, Zero, ...
time_style    = clock      # clock = time_format | spoken = "quarter past two" (English)
pause_ms      = 1000       # how long %PAUSE is
#speed        = 0.8        # slower or faster speech: elevenlabs 0.7..1.2, openai 0.25..4
time_format   = %H:%M      # strftime
date_format   = %A %-d %B %Y
#locale       = nl_BE.UTF-8   # the language of the day and month names
provider      = openai     # openai (and services with the same API) | elevenlabs
#url          =            # another endpoint than the provider's own
#token        =            # the API key. Keep this file out of git.
#model        = gpt-4o-mini-tts
#voice        = alloy      # elevenlabs: the voice id
#style        = Calm and clear, like a radio announcer.   # openai: how to say it

# Who is talking, for a machine: a noise-like signal under the transmit audio
# that a phone or a small device next to a radio reads the callsign from
# (docs/TAG.md). A listener hears a little more hiss in the quiet tail.
# Format v0: it may change. Without a [tag] section it is off.
[tag]
enabled       = true
level_db      = -43        # dBFS RMS, as speech is measured: 32 dB under speech
                           # that was brought to -11

[dtmf]
# The digits come from the receiver, already decoded.
commands      = true       # <tg_prefix><talkgroup>#  selects a talkgroup
                           # <tg_prefix>0#            back to the home talkgroup
                           # <tg_prefix>#             the talkgroup used before
tg_prefix     = 91         # 91 = as on an SvxLink node: 911745# selects talkgroup 1745
ack           = true       # answer a command with the talkgroup number in Morse

[gate]
tail_silence  = true       # The transmitter runs a little behind its receiver (the
                           # TX delay, the sound card). true = when the station on
                           # the input unkeys, what still waits is dropped: it
                           # listens to the output now and would hear the end of
                           # its own over come back. false = send it all. Set it
                           # the same as on the receivers ([gate] there).

[audio]
alsa_device   = plughw:0   # the sound card the radio is on (WM8960 audio HAT)
tx_channel    = left       # left | right — the codec channel the radio is on
playback_pct  = 77         # sound card "Headphone" level 0..100 — audio to the radio.
                           #   This sets the deviation.
                           # As in `amixer set <control> N%`; "keep" = do not touch
                           # the mixer. Only applied on a WM8960.

# Every station comes in at its own level — its deviation, its microphone, this
# receiver's sound card. Before the audio goes to the talkgroup and the transmitter
# every over is brought to the same speech level, so that all repeaters and
# nodes on a reflector sound equally loud.
deemphasis    = false      # true = audio straight from a discriminator: bring the
                           #   treble down again (6 dB/octave), in software
normalize     = true
normalize_target_db   = -20   # the level speech is brought to (dBFS RMS)
normalize_max_gain_db = 30    # a weak station is amplified by this much at most
preamp_db     = 0          # fixed software gain before the normaliser
buffer_periods = 4         # sound card buffer, in 20 ms periods (2..16)

[status]
http_port     = 8080       # read-only status page (0 = off): http://<this box>:8080/
admin         = true       # http://<this box>:8080/admin — the configuration in a
                           # browser, restart, block receiver / transmitter, API
                           # keys (/api/v1). One user, admin; the password is
                           # admin until the first login, which has to change it,
                           # and that first login works from a private address only.
#admin_file   = /var/lib/tailchaser/admin-<role>.conf   # password, keys, blocks
monitor       = false      # true: a "Listen" card on the status page (level, spectrum) — the audio
                           # of the receiver and of what is transmitted, in the browser
                           # (ws://<this box>:8080/monitor/rx and /tx). For setting up and
                           # debugging: whoever can open the status page can then listen.
bind          = 0.0.0.0

[gpio]
chip          = auto       # auto-detect the 40-pin header chip, or /dev/gpiochipN

[log]
level         = info       # error | warn | info | debug
